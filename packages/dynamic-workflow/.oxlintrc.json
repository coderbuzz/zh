{
  // 本包自带的 oxlint 配置：必须显式存在，否则配置自动发现会跨包上溯。
  // 规则通过 extends 继承仓库根的 .oxlintrc.json，只有下方 ignorePatterns
  // 是本包特有的差异。
  //
  // 分析测试的图体语料（顶层 return、顶层 for-await、裸 agent()）不是合法模块语法，
  // 在 ignorePatterns 统一排除。
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "extends": ["../../.oxlintrc.json"],
  "ignorePatterns": [
    "tests/workflows/**",
    "tests/graphs/**",
    "tests/holes/**",
    "tests/schemas/**",
    "tests/schema-errors/**"
  ],
  // override 留空：文件超出 max-lines 上限时应拆模块，而不是回到这里加豁免名单。
  "overrides": []
}
