+// Web server 等宿主不注册 window-controller channel；宿主在 promise 等待超时后
+// 以 PromiseError 回包：client 侧构造的 Error 是 name="Unknown channel"、
+// message="Channel name '...' timed out after ...ms"。标记在 Error#name 上，
+// message 本身不含 "Unknown channel"，检测必须看 name（plain-object 拒绝值也兼容）。
+// 宿主不存在 controller 时应静默回退空列表，而不是每次 mount 打 3 轮超时 RPC 并刷 error 日志。
+function isUnknownChannelError(error: unknown): boolean {
+  const extractText = (candidate: unknown): string => {
+    if (candidate instanceof Error) {
+      return `${candidate.name} ${candidate.message}`;
+    }
+    if (typeof candidate === "string") {
+      return candidate;
+    }
+    if (candidate && typeof candidate === "object") {
+      const { name, message } = candidate as { name?: unknown; message?: unknown };
+      return `${typeof name === "string" ? name : ""} ${
+        typeof message === "string" ? message : ""
+      }`;
+    }
+    return String(candidate);
+  };
+  return /unknown channel/i.test(extractText(error));
+}
+
+function createEmptyTaskListResult(): WindowHostControllerTaskListResult {
+  return { items: [], total: 0, hasMore: false };
