 ): IZCodeSessionService {
-  const services = workspacePath
-    ? useWorkspaceServices(workspacePath, preferredRemoteSessionId, workspaceIdentity)
-    : useServices();
-  return services.zcodeSessionService;
+  // 两条分支的 hook 数量不同（useWorkspaceServices 内部包含多个 context/store hook），
+  // 而 workspacePath 会在 workspace attach 过程中从 undefined 变为有值；
+  // 三元直接切换分支会触发 React "change in the order of Hooks" 并使子树崩溃
+  // （onboarding dialog 恢复会话时首次触发）。两条分支都必须无条件执行，
+  // 只在取值时按 workspacePath 选择，保持各分支原有语义不变。
+  const contextServices = useServices();
+  const workspaceServices = useWorkspaceServices(
+    workspacePath,
+    preferredRemoteSessionId,
+    workspaceIdentity,
+  );
+  return workspacePath
+    ? workspaceServices.zcodeSessionService
+    : contextServices.zcodeSessionService;
 }
