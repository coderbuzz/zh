@@ -1,3 +1,17 @@
+// Enter-to-send is a keyboard-first convention. On touch-primary devices
+// (phones with soft keyboards such as Gboard) the virtual Enter inserts a
+// newline instead and sending goes through the explicit send button — there
+// is no Shift key to reach a line break with. pointer:coarse matches the
+// primary input mechanism, so a desktop with a touchscreen still resolves to
+// fine and keeps the desktop behavior.
+export function isTouchPrimaryDevice(): boolean {
+  try {
+    return window.matchMedia("(pointer: coarse)").matches;
+  } catch {
+    return false;
+  }
+}
